rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(field) {
      return field is string && field.size() > 0 && field.size() <= 2000;
    }

    // ─── Users: Only the owner can read/write their own subtree ───────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Profile document
      match /profile/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Settings document
      match /settings/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Stats document
      match /stats/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Books collection
      match /books/{bookId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidString(request.resource.data.title)
          && isValidString(request.resource.data.author);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Reading sessions
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0;
        allow update, delete: if isOwner(userId);
      }

      // Reading progress
      match /progress/{bookId} {
        allow read, write: if isOwner(userId);
      }

      // Notes and highlights
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidString(request.resource.data.content);
        allow update, delete: if isOwner(userId);
      }

      // Bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // Vocabulary words
      match /vocabulary/{wordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidString(request.resource.data.word);
        allow update, delete: if isOwner(userId);
      }

      // Reading goals
      match /reading_goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Block all other access ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

