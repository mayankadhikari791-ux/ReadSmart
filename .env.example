# ReadSmart Environment Configuration Template
# Copy this file to .env or pass variables directly using:
# flutter run --dart-define-from-file=.env

# API Endpoints
API_BASE_URL=https://api.readsmart.app/v1
AUTH_ENDPOINT=https://auth.readsmart.app

# Client Credentials (Do NOT commit actual production keys)
API_KEY=your_readsmart_api_key_here

# Environment (development, staging, production)
ENVIRONMENT=development

# Network Timeouts (in milliseconds)
REQUEST_TIMEOUT_MS=15000

# Feature Toggles
ENABLE_CLOUD_SYNC=true
CACHE_DURATION_HOURS=72

# Dictionary & Translation Proxy (when using secure backend proxy)
DICTIONARY_PROXY_URL=https://api.readsmart.app/v1/dictionary
TRANSLATION_PROXY_URL=https://api.readsmart.app/v1/translate
USE_DICTIONARY_PROXY=false
# Only used server-side/proxy-side (never commit real secrets):
DICTIONARY_API_KEY=your_private_dictionary_key_here

